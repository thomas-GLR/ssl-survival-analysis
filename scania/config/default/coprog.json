{
  "dataset_params": {
    "sequence_len": 64,
    "seed": 42,
    "data_fraction": 1.0,
    "val_rate": 0.15,
    "test_rate": 0.15,
    "stratify": true,
    "norm_type": "z-score",
    "num_workers": 20,
    "pin_memory": true,
    "return_sequence_label": false,
    "batch_size": 128,
    "shuffle_loader": true,
    "counter_mode": "cumulative",
    "include_histograms": true,
    "histogram_mode": "sum"
  },
  "model_params": {
    "first_model": {
      "cnn": {
      }
    },
    "second_model": {
      "lstm": {
        "hidden_dim": 64,
        "lstm_num_layers": 2,
        "lstm_dropout": 0.2,
        "fc_layer_dim": 256,
        "fc_dropout": 0.2
      }
    }
  },
  "training_params": {
    "lr": [0.001, 0.002],
    "patiences": [100, 100],
    "max_epochs": [500, 500],
    "coprog_iterations": 20,
    "coprog_suspension_pool_size": 100,
    "rul_target_standardization": [false, false]
  }
}