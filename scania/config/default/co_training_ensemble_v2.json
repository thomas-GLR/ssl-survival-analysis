{
  "dataset_params": {
    "sequence_len": 64,
    "seed": 42,
    "data_fraction": 1.0,
    "val_rate": 0.15,
    "test_rate": 0.15,
    "calib_rate": 0.1,
    "stratify": true,
    "norm_type": "z-score",
    "num_workers": 20,
    "pin_memory": true,
    "return_sequence_label": false,
    "batch_size": 32,
    "shuffle_loader": true,
    "counter_mode": "cumulative",
    "include_histograms": true,
    "histogram_mode": "sum"
  },
  "model_params": {
    "models": [
      {
        "rulcnn": {
          "model_params": {},
          "lr": 0.001,
          "weight_decay": 0,
          "max_epochs": 100,
          "patience": 10,
          "rul_target_standardization": false
        }
      },
      {
        "mlp": {
          "model_params": {},
          "lr": 0.0004,
          "weight_decay": 0,
          "max_epochs": 100,
          "patience": 10,
          "rul_target_standardization": false
        }
      },
      {
        "bilstm_attention": {
          "model_params": {
            "hidden_dim": 128,
            "lstm_num_layers": 4
          },
          "lr": 0.0004,
          "weight_decay": 0,
          "max_epochs": 200,
          "patience": 20,
          "rul_target_standardization": false
        }
      }
    ]
  },
  "training_params": {
    "iterations": 20,
    "suspension_pool_size": 0.35,
    "add_ratio": 0.05,
    "confidence": 0.95,
    "inference_batch_size": 1024,
    "use_average_window_confidence": true,
    "confidence_width_threshold": 3.0,
    "use_monotone_projection": true,
    "monotone_residual_weight": 1.0,
    "disable_isotonic_regression": false,
    "use_fine_tuning": false,
    "fine_tune_lr_factor": 0.1,
    "fine_tune_max_epochs": 20,
    "fine_tune_patience":  5,
    "fine_tune_from_initial_model": false,
    "peer_weighted_pseudo_label": false,
    "bagging_failure_data": false,
    "keep_best_model_mode": null,
    "isotonic_time_weighting":  true,
    "computing_weight_mode": "val_rmse",
    "use_cotraining_ensemble_survival_loss_function": true,
    "cotraining_survival_loss_lambda": 0.7,
    "use_mondrian_categorizer": true,
    "mondrian_no_bins": 10,
    "use_cps": true,
    "difficulty_estimator_k": 25
  }
}
